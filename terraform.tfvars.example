dashboard_cidrs = [
  "203.0.113.10/32",
]

# expected_account_id = "123456789012"  # apply refuses to run in any other account

# cost switches: true = running, false = torn down (data lake is kept either way)
# kafka_enabled     = true
# dashboard_enabled = true
